@@ -9,6 +9,7 @@
 #include "platformsupport/scenes/opengl/abstract_egl_backend.h"
 #include "compositor.h"
 #include "core/drmdevice.h"
+#include "core/graphicsbuffer.h"
 #include "core/outputbackend.h"
 #include "main.h"
 #include "opengl/egl_context_attribute_builder.h"
@@ -94,6 +95,40 @@ void AbstractEglBackend::setEglDisplay(EglDisplay *display)
     setSupportsBufferAge(m_display->supportsBufferAge());
 }
 
+// [PoC dmabuf-poc] Format table advertised when there is no DrmDevice at all
+// and the EGL implementation does not report any importable dma-buf format.
+//
+// With Anland/KGSL surfaceless EGL, EglDisplay::queryImportFormats() comes back
+// empty (the EGL display does not expose EGL_EXT_image_dma_buf_import_modifiers),
+// so KWin has nothing to put in a tranche and never creates the
+// zwp_linux_dmabuf_v1 global. Advertising a conservative linear-only table at
+// least makes the global and a plausible format list visible to clients, which
+// is what this PoC is after.
+//
+// Only DRM_FORMAT_MOD_LINEAR is claimed: KGSL allocations are linear, and
+// advertising an implicit/tiled modifier would be a lie clients could not
+// satisfy. Importing these buffers is NOT guaranteed - see testImportBuffer().
+static const QHash<uint32_t, QList<uint64_t>> &fallbackDmaBufFormats()
+{
+    static const QHash<uint32_t, QList<uint64_t>> ret = [] {
+        const uint32_t formats[] = {
+            DRM_FORMAT_ARGB8888,
+            DRM_FORMAT_XRGB8888,
+            DRM_FORMAT_ABGR8888,
+            DRM_FORMAT_XBGR8888,
+            DRM_FORMAT_ABGR2101010,
+            DRM_FORMAT_XRGB2101010,
+        };
+
+        QHash<uint32_t, QList<uint64_t>> table;
+        for (const uint32_t format : formats) {
+            table.insert(format, {DRM_FORMAT_MOD_LINEAR});
+        }
+        return table;
+    }();
+    return ret;
+}
