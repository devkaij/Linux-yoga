 void AbstractEglBackend::initWayland()
 {
     if (!WaylandServer::self()) {
@@ -194,18 +229,47 @@ void AbstractEglBackend::initWayland()
         dmabuf->setSupportedFormatsWithModifiers(m_tranches);
     }
     else {
-        const auto formats = m_display->nonExternalOnlySupportedDrmFormats();
-        if (!formats.isEmpty()) {
-            m_tranches.append({
-                .device = m_display->renderDevNode().value_or(0),
-                .flags = {},
-                .formatTable = formats,
-            });
-
-            LinuxDmaBufV1ClientBufferIntegration *dmabuf = waylandServer()->linuxDmabuf();
-            dmabuf->setRenderBackend(this);
-            dmabuf->setSupportedFormatsWithModifiers(m_tranches);
+        // [PoC dmabuf-poc] No DrmDevice: surfaceless EGL (Anland/KGSL/Turnip).
+        //
+        // The client-buffer integration and its zwp_linux_dmabuf_v1 global do
+        // not actually need a DRM device - only the scanout/tranche side does.
+        // Create them unconditionally so the global is published even when EGL
+        // reports no importable formats.
+        const bool hasDmaBufImport = m_display->hasExtension(QByteArrayLiteral("EGL_EXT_image_dma_buf_import"));
+        const bool hasDmaBufModifiers = m_display->hasExtension(QByteArrayLiteral("EGL_EXT_image_dma_buf_import_modifiers"));
+
+        QHash<uint32_t, QList<uint64_t>> formats = m_display->nonExternalOnlySupportedDrmFormats();
+        if (formats.isEmpty()) {
+            qCWarning(KWIN_OPENGL) << "[dmabuf-poc] no DRM device and no EGL-reported dma-buf formats"
+                                   << "(EGL_EXT_image_dma_buf_import:" << hasDmaBufImport
+                                   << "EGL_EXT_image_dma_buf_import_modifiers:" << hasDmaBufModifiers << ")";
+            formats = fallbackDmaBufFormats();
+            qCWarning(KWIN_OPENGL) << "[dmabuf-poc] advertising" << formats.size()
+                                   << "linear fallback formats anyway; the global will exist but importing buffers is not guaranteed";
+        } else {
+            qCWarning(KWIN_OPENGL) << "[dmabuf-poc] no DRM device, advertising" << formats.size()
+                                   << "EGL-reported dma-buf formats";
         }
+
+        // wl_drm needs a real DRM device node to hand out in its "device" event.
+        // With Anland/KGSL there is none, and handing clients an empty path
+        // would just make them fail to open(""), so only advertise it if EGL
+        // knows a render node.
+        const QString renderNode = m_display->renderNode();
+        if (!renderNode.isEmpty()) {
+            qCWarning(KWIN_OPENGL) << "[dmabuf-poc] advertising wl_drm for render node" << renderNode;
+            waylandServer()->drm()->setDevice(renderNode);
+        }
+
+        m_tranches.append({
+            .device = m_display->renderDevNode().value_or(0),
+            .flags = {},
+            .formatTable = formats,
+        });
+
+        LinuxDmaBufV1ClientBufferIntegration *dmabuf = waylandServer()->linuxDmabuf();
+        dmabuf->setRenderBackend(this);
+        dmabuf->setSupportedFormatsWithModifiers(m_tranches);
     }
     waylandServer()->setRenderBackend(this);
 }
